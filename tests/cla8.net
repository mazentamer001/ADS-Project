# 8-bit carry-lookahead adder, two 4-bit lookahead groups
INPUT cin a0 b0 a1 b1 a2 b2 a3 b3 a4 b4 a5 b5 a6 b6 a7 b7
OUTPUT s0 s1 s2 s3 s4 s5 s6 s7 c8
XOR p0 1 a0 b0
AND g0 1 a0 b0
XOR p1 1 a1 b1
AND g1 1 a1 b1
XOR p2 1 a2 b2
AND g2 1 a2 b2
XOR p3 1 a3 b3
AND g3 1 a3 b3
XOR p4 1 a4 b4
AND g4 1 a4 b4
XOR p5 1 a5 b5
AND g5 1 a5 b5
XOR p6 1 a6 b6
AND g6 1 a6 b6
XOR p7 1 a7 b7
AND g7 1 a7 b7
AND cla1_cin_0_0 1 cin p0
OR c1 1 g0 cla1_cin_0_0
AND cla2_g0_0_0 1 g0 p1
AND cla2_cin_0_0 1 cin p0
AND cla2_cin_1_0 1 cla2_cin_0_0 p1
OR c2_or0 1 g1 cla2_g0_0_0
OR c2 1 c2_or0 cla2_cin_1_0
AND cla3_g1_0_0 1 g1 p2
AND cla3_g0_0_0 1 g0 p1
AND cla3_g0_1_0 1 cla3_g0_0_0 p2
AND cla3_cin_0_0 1 cin p0
AND cla3_cin_0_1 1 p1 p2
AND cla3_cin_1_0 1 cla3_cin_0_0 cla3_cin_0_1
OR c3_or0 1 g2 cla3_g1_0_0
OR c3_or1 1 c3_or0 cla3_g0_1_0
OR c3 1 c3_or1 cla3_cin_1_0
AND cla4_g2_0_0 1 g2 p3
AND cla4_g1_0_0 1 g1 p2
AND cla4_g1_1_0 1 cla4_g1_0_0 p3
AND cla4_g0_0_0 1 g0 p1
AND cla4_g0_0_1 1 p2 p3
AND cla4_g0_1_0 1 cla4_g0_0_0 cla4_g0_0_1
AND cla4_cin_0_0 1 cin p0
AND cla4_cin_0_1 1 p1 p2
AND cla4_cin_1_0 1 cla4_cin_0_0 cla4_cin_0_1
AND cla4_cin_2_0 1 cla4_cin_1_0 p3
OR c4_or0 1 g3 cla4_g2_0_0
OR c4_or1 1 c4_or0 cla4_g1_1_0
OR c4_or2 1 c4_or1 cla4_g0_1_0
OR c4 1 c4_or2 cla4_cin_2_0
AND cla5_cin_0_0 1 c4 p4
OR c5 1 g4 cla5_cin_0_0
AND cla6_g4_0_0 1 g4 p5
AND cla6_cin_0_0 1 c4 p4
AND cla6_cin_1_0 1 cla6_cin_0_0 p5
OR c6_or0 1 g5 cla6_g4_0_0
OR c6 1 c6_or0 cla6_cin_1_0
AND cla7_g5_0_0 1 g5 p6
AND cla7_g4_0_0 1 g4 p5
AND cla7_g4_1_0 1 cla7_g4_0_0 p6
AND cla7_cin_0_0 1 c4 p4
AND cla7_cin_0_1 1 p5 p6
AND cla7_cin_1_0 1 cla7_cin_0_0 cla7_cin_0_1
OR c7_or0 1 g6 cla7_g5_0_0
OR c7_or1 1 c7_or0 cla7_g4_1_0
OR c7 1 c7_or1 cla7_cin_1_0
AND cla8_g6_0_0 1 g6 p7
AND cla8_g5_0_0 1 g5 p6
AND cla8_g5_1_0 1 cla8_g5_0_0 p7
AND cla8_g4_0_0 1 g4 p5
AND cla8_g4_0_1 1 p6 p7
AND cla8_g4_1_0 1 cla8_g4_0_0 cla8_g4_0_1
AND cla8_cin_0_0 1 c4 p4
AND cla8_cin_0_1 1 p5 p6
AND cla8_cin_1_0 1 cla8_cin_0_0 cla8_cin_0_1
AND cla8_cin_2_0 1 cla8_cin_1_0 p7
OR c8_or0 1 g7 cla8_g6_0_0
OR c8_or1 1 c8_or0 cla8_g5_1_0
OR c8_or2 1 c8_or1 cla8_g4_1_0
OR c8 1 c8_or2 cla8_cin_2_0
XOR s0 1 p0 cin
XOR s1 1 p1 c1
XOR s2 1 p2 c2
XOR s3 1 p3 c3
XOR s4 1 p4 c4
XOR s5 1 p5 c5
XOR s6 1 p6 c6
XOR s7 1 p7 c7
